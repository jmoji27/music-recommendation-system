DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/music_rec

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Free at https://aistudio.google.com/apikey. Optional — /me/recommendations
# gracefully returns {"available": false} without this, rather than erroring.
GEMINI_API_KEY=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

JWT_SECRET=change-me-generate-a-random-value

FRONTEND_ORIGIN=http://127.0.0.1:5173

# "development" locally (default). Set to "production" on the real
# deployment — controls cookie Secure/SameSite flags (see app/cookies.py).
ENVIRONMENT=development
